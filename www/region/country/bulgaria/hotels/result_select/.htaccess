AddType application/x-httpd-php5 .php

RewriteEngine On
RewriteBase /region/country/bulgaria/hotels/result_select
RewriteRule ^page/([^/]*)\.html$ /region/country/bulgaria/hotels/?page=$1 [L]
RewriteRule ^resort/([^/]*)\.html$ /region/country/bulgaria/hotels/result_select/?resort=$1 [L]
RewriteRule (.+)(/)$ $1.html [L,QSA]

